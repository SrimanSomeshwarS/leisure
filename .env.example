# Copy to .env and replace every CHANGE_ME. Never commit .env.
APP_ENV=development                 # development | test | production

MYSQL_ROOT_PASSWORD=CHANGE_ME_root_password
MYSQL_PASSWORD=CHANGE_ME_app_password
# docker-compose overrides DATABASE_URL for the api container; set it yourself outside Docker/production.
DATABASE_URL=mysql+pymysql://leisure:CHANGE_ME_app_password@localhost:3306/leisure?charset=utf8mb4

# Generate: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=CHANGE_ME_generate_a_long_random_value_at_least_32_chars

PUBLIC_API_BASE_URL=http://localhost:8000
FRONTEND_BASE_URL=https://placid-guava-076141.framer.app
# Comma-separated exact origins. No wildcards. https only in production.
CORS_ORIGINS=https://placid-guava-076141.framer.app,http://localhost:3000
DOCS_ENABLED=true

# --- Sessions ---
COOKIE_NAME=leisure_session
COOKIE_DOMAIN=
COOKIE_SECURE=false                 # must be true in production
COOKIE_SAMESITE=lax
# DEV ONLY: lets the *.framer.app preview log in via Authorization: Bearer (cookies can't work cross-site).
# Refused in production.
AUTH_ALLOW_BEARER=true

# --- Email ---
EMAIL_BACKEND=smtp                  # smtp | console | memory (production requires smtp)
EMAIL_FROM=Leisure <no-reply@CHANGE_ME_your_domain>
SMTP_HOST=mailpit
SMTP_PORT=1025
SMTP_USERNAME=
SMTP_PASSWORD=
SMTP_STARTTLS=false

# --- Commercial rules: documented in docs/decisions.md, wired in Batches 3-5 ---
